DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/payflow

NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

PAYFLOW_CONTRACT_ID=payflow.testnet
PAYFLOW_CONTRACT_ADMIN_ID=payflowadmin.testnet

PAYFLOW_ADMIN_FUNCTION_CALL_PUBLIC_KEY=ed25519:<YOUR_PUBLIC_KEY>
PAYFLOW_ADMIN_FUNCTION_CALL_PRIVATE_KEY=ed25519:<YOUR_SECRET_KEYPAIR>

AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7

RELAYER_URL=
RELAYER_API_KEY=
RELAYER_MAX_GAS=100000000000000

# Generate using `python -c "import secrets; print(secrets.token_urlsafe(32))"`
INTERNAL_API_KEY=

USDC_ASSET_ID=
USDC_DECIMALS=6

